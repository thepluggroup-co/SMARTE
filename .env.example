# Copier vers .env. Ne jamais déposer le fichier .env dans le dépôt.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/erp
DATABASE_URL=postgres://erp_app:changer_ce_mot_de_passe@localhost:5432/erp
ERP_APP_MOT_DE_PASSE=changer_ce_mot_de_passe
PORT=3000
# Générer avec : openssl rand -base64 32
ERP_CLE_SECRETS=
ERP_URL_PUBLIQUE=http://localhost:3000
# Mettre "oui" seulement derrière le proxy de l'hébergeur
ERP_DERRIERE_PROXY=non
# Uniquement pour npm run provisionner:sgc
SGC_ADMIN_EMAIL=
SGC_ADMIN_MOT_DE_PASSE=

# Facultatif : vidéos hébergées sur le serveur
# ERP_DOSSIER_MEDIAS=/var/lib/smarte/medias
# ERP_VIDEO_MAX_MO=2048

# Facultatif : studio IA. La clé et le modèle sont propres au compte API de SGC.
# ERP_IA_CLE=
# ERP_IA_MODELE=
